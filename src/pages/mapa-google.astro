---
import Layout from '../layouts/Layout.astro';
import GoogleCoastalMap from '../components/GoogleCoastalMap';
import MapHeader from '../components/MapHeader';

const title = 'Mapa Satelital - Erosión Costera Dibulla-Palomino';
const description = 'Visualización interactiva de líneas costeras históricas (2000-2024) usando imágenes satelitales de Google Earth Engine para la costa de Dibulla-Palomino, La Guajira.';
---

<Layout 
  title={title} 
  description={description}
  keywords="erosión costera, dibulla, palomino, guajira, google earth engine, landsat, líneas costeras, MNDWI, análisis temporal"
>
  <div class="relative w-full h-screen overflow-hidden bg-slate-900">
    <!-- Header profesional con logo -->
    <MapHeader client:load />

    <!-- Mapa a pantalla completa -->
    <GoogleCoastalMap 
      apiKey="AIzaSyANyOOq7IA2r5ku07DSWujhAXxOFlaVP-c"
      className="w-full h-full"
      client:only="react"
    />

    <!-- Footer informativo profesional -->
    <div class="absolute bottom-0 left-0 right-0 z-[1001] pointer-events-none">
      <div class="bg-gradient-to-t from-slate-900/98 via-slate-900/95 to-transparent backdrop-blur-md px-6 py-4 border-t border-slate-800/50">
        <div class="max-w-7xl mx-auto">
          <div class="flex items-center justify-between pointer-events-auto">
            <div class="flex items-start gap-4">
              <div class="w-10 h-10 bg-gradient-to-br from-orange-500 via-red-500 to-red-600 rounded-lg flex items-center justify-center flex-shrink-0 shadow-lg shadow-red-500/30">
                <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
                </svg>
              </div>
              <div class="flex-1">
                <h3 class="text-white text-sm font-semibold mb-1 flex items-center gap-2">
                  Sistema de Monitoreo de Erosión Costera
                  <span class="px-2 py-0.5 bg-red-500/20 text-red-400 rounded text-xs font-medium border border-red-500/30">
                    Zona Crítica
                  </span>
                </h3>
                <p class="text-slate-400 text-xs max-w-2xl leading-relaxed">
                  Datos satelitales procesados vía Google Earth Engine • Landsat 5-9 (2000-2024) • 
                  Algoritmo MNDWI/NDWI • Resolución 30m • Metodología CoastSat
                </p>
              </div>
            </div>

            <div class="flex items-center gap-3 flex-shrink-0">
              <div class="hidden lg:flex items-center gap-2">
                <span class="px-3 py-1.5 bg-emerald-500/10 text-emerald-400 rounded-lg text-xs font-mono border border-emerald-500/20">
                  API REST
                </span>
                <span class="px-3 py-1.5 bg-blue-500/10 text-blue-400 rounded-lg text-xs font-mono border border-blue-500/20">
                  GeoJSON
                </span>
              </div>

              <a 
                href="/api/coastlines" 
                target="_blank"
                class="px-4 py-2 bg-gradient-to-r from-cyan-600 to-blue-600 hover:from-cyan-700 hover:to-blue-700 text-white rounded-lg text-sm font-medium transition-all flex items-center gap-2 shadow-lg shadow-cyan-500/20"
              >
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                </svg>
                <span>API Docs</span>
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <style>
    /* Estilos profesionales para el mapa */
    .gm-style-cc {
      display: none !important;
    }

    /* Ajustar z-index de controles de Google Maps */
    .gm-bundled-control {
      margin-top: 90px !important;
      margin-right: 10px !important;
    }

    /* Animaciones suaves */
    @keyframes fadeIn {
      from {
        opacity: 0;
        transform: translateY(-10px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes shimmer {
      0% {
        transform: translateX(-100%);
      }
      100% {
        transform: translateX(100%);
      }
    }

    @keyframes spin-slow {
      from {
        transform: rotate(0deg);
      }
      to {
        transform: rotate(360deg);
      }
    }

    :global(.animate-fadeIn) {
      animation: fadeIn 0.3s ease-out;
    }

    :global(.animate-shimmer) {
      animation: shimmer 2s infinite;
    }

    :global(.animate-spin-slow) {
      animation: spin-slow 3s linear infinite;
    }

    /* Mejoras visuales */
    :global(.gm-style .gm-style-iw-c) {
      border-radius: 12px !important;
      box-shadow: 0 20px 25px -5px rgb(0 0 0 / 0.1), 0 8px 10px -6px rgb(0 0 0 / 0.1) !important;
    }

    :global(.gm-style .gm-style-iw-d) {
      overflow: auto !important;
    }
  </style>
</Layout>
