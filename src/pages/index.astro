---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header';
import HeroCarousel from '../components/HeroCarousel';
import TechCarousel from '../components/TechCarousel';
import CaseStudyCarousel from '../components/CaseStudyCarousel';
import MonitoringTabs from '../components/MonitoringTabs';
import MangroveHero from '../components/manglares/MangroveHero';
---

<Layout title="Achiki O'pala - Sistema de Alerta Temprana">
  <main class="relative w-full overflow-x-hidden bg-[#f5f5f0]">
    <!-- Hero Section -->
    <section class="relative h-screen w-full overflow-hidden">
      <!-- Header with dark background -->
      <div class="absolute top-0 left-0 right-0 z-50 bg-[#2d2d2d]">
        <Header client:load />
      </div>

      <!-- Video Background -->
      <div class="absolute inset-0 z-0">
        <video
          autoplay
          loop
          muted
          playsinline
          preload="auto"
          class="absolute inset-0 w-full h-full object-cover"
          id="hero-video"
        >
          <source src="/video.mp4" type="video/mp4" />
        </video>
        
        <!-- Dark overlay -->
        <div class="absolute inset-0 bg-gradient-to-b from-black/40 via-black/20 to-black/60"></div>
      </div>

      <!-- Hero Content -->
      <div class="relative z-10 h-full flex items-center">
        <div class="container mx-auto px-8 lg:px-16">
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
            <!-- Left: Main Headline -->
            <div class="space-y-8">
              <!-- Badge -->
              <div class="inline-flex items-center gap-3 bg-black/40 backdrop-blur-md rounded-full px-6 py-3 border border-white/10">
                <span class="text-white/90 text-sm font-medium">Sistema #1 de alerta temprana</span>
                <a href="#" class="text-cyan-400 text-sm font-medium flex items-center gap-1 hover:gap-2 transition-all">
                  Leer caso de estudio
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                  </svg>
                </a>
              </div>

              <!-- Main Headline -->
              <h1 class="text-4xl lg:text-5xl font-bold text-white leading-[1.1]">
                El sistema de monitoreo para <span class="block mt-2">proteger tu costa</span>
              </h1>

              <!-- Description -->
              <p class="text-lg text-white/80 leading-relaxed max-w-xl">
                Tecnología de sensores IoT, análisis geoespacial e IA comunitaria. Flujos inteligentes para control profesional y colaboración. Protección costera a cualquier escala.
              </p>

              <!-- CTA Buttons -->
              <div class="flex flex-wrap gap-4">
                <a href="/mapa-google" class="bg-white text-black px-8 py-4 rounded-lg font-semibold text-lg hover:bg-white/90 transition-all inline-block">
                  Ver Mapa Interactivo
                </a>
                <a href="/documentacion" class="bg-black/40 backdrop-blur-md text-white px-8 py-4 rounded-lg font-semibold text-lg border border-white/20 hover:bg-black/60 transition-all flex items-center gap-2">
                  <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M8 5v14l11-7z"></path>
                  </svg>
                  ¿Por qué Achiki O'pala?
                </a>
              </div>
            </div>

            <!-- Right: Animated Feature List -->
            <div class="lg:pl-12">
              <HeroCarousel client:load />
            </div>
          </div>
        </div>
      </div>

      <!-- Trust Bar - Partners -->
      <div class="absolute bottom-0 left-0 right-0 z-20 bg-black/60 backdrop-blur-xl border-t border-white/10">
        <div class="container mx-auto px-8 lg:px-16 py-6">
          <p class="text-white/60 text-sm text-center mb-4">
            Confiado por 1M+ ciudadanos – comunidades, entidades, agencias y gobiernos
          </p>
          <div class="flex justify-center items-center gap-12 flex-wrap opacity-50 grayscale">
            <!-- Partner logos - placeholder -->
            <div class="text-white/40 font-bold text-lg">UNGRD</div>
            <div class="text-white/40 font-bold text-lg">PNUD</div>
            <div class="text-white/40 font-bold text-lg">MinAmbiente</div>
            <div class="text-white/40 font-bold text-lg">Dibulla</div>
            <div class="text-white/40 font-bold text-lg">La Guajira</div>
          </div>
        </div>
      </div>
    </section>

    <!-- Section: One place to monitor everything -->
    <section class="py-32 bg-[#f5f5f0]">
      <div class="container mx-auto px-8 lg:px-16">
        <!-- Section Header -->
        <div class="text-center mb-16">
          <h2 class="text-5xl lg:text-6xl font-bold text-[#2d1810] mb-6">
            Un lugar para monitorear todo
          </h2>
          <p class="text-xl text-[#2d1810]/70 max-w-3xl mx-auto">
            Elige tu punto de partida. Cada herramienta, cada modelo, cada formato.
          </p>
        </div>

        <!-- Interactive Monitoring Tabs -->
        <MonitoringTabs client:load />
      </div>
    </section>

    <!-- Section: Mangrove Restoration Hero -->
    <MangroveHero client:load />

    <!-- Section: With all the latest models -->
    <section class="py-32 bg-white">
      <div class="container mx-auto px-8 lg:px-16">
        <!-- Section Header -->
        <div class="text-center mb-16">
          <h2 class="text-5xl lg:text-6xl font-bold text-[#2d1810] mb-6">
            Con toda la tecnología más reciente
          </h2>
          <p class="text-xl text-[#2d1810]/70 max-w-4xl mx-auto">
            Accede a las compañías líderes mundiales en tecnología para que nunca tengas que elegir entre los mejores modelos y el flujo de trabajo más fácil.
          </p>
        </div>

        <!-- Interactive Tech Carousel -->
        <TechCarousel client:load />
      </div>
    </section>

    <!-- Section: Start simple, Scale when ready -->
    <section class="py-32 bg-[#f5f5f0]">
      <div class="container mx-auto px-8 lg:px-16">
        <!-- Section Header -->
        <div class="mb-16">
          <h2 class="text-5xl lg:text-7xl font-bold text-[#2d1810] mb-6">
            Comienza simple.<br />
            Escala cuando estés listo
          </h2>
          <p class="text-xl text-[#2d1810]/70 max-w-2xl">
            Desde una sola herramienta hasta un flujo completo, a tu propio ritmo.
          </p>
        </div>

        <!-- Feature Grid -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
          <!-- Card 1: Every tool ready -->
          <div class="bg-[#e8e6e1] rounded-3xl p-12 hover:scale-[1.02] transition-transform">
            <h3 class="text-4xl font-bold text-[#2d1810] mb-6">
              Cada herramienta, lista para usar
            </h3>
            <p class="text-[#2d1810]/70 text-lg leading-relaxed mb-8">
              Sensores, satélites, IA — treinta herramientas, sin configuración. Abre lo que necesitas, crea lo que quieras.
            </p>
            <div class="bg-white rounded-2xl p-6 border border-gray-200">
              <div class="flex gap-3 mb-4">
                <button class="px-4 py-2 bg-[#2d1810] text-white rounded-lg text-sm font-medium">TODO</button>
                <button class="px-4 py-2 bg-white text-[#2d1810] rounded-lg text-sm font-medium border border-gray-200">SENSORES</button>
                <button class="px-4 py-2 bg-white text-[#2d1810] rounded-lg text-sm font-medium border border-gray-200">SATÉLITES</button>
                <button class="px-4 py-2 bg-white text-[#2d1810] rounded-lg text-sm font-medium border border-gray-200">IA</button>
              </div>
              <div class="grid grid-cols-2 gap-4">
                <div class="aspect-square bg-gradient-to-br from-pink-200 to-purple-300 rounded-xl"></div>
                <div class="aspect-square bg-gradient-to-br from-cyan-200 to-blue-300 rounded-xl"></div>
                <div class="aspect-square bg-gradient-to-br from-orange-200 to-red-300 rounded-xl"></div>
                <div class="aspect-square bg-gradient-to-br from-green-200 to-emerald-300 rounded-xl"></div>
              </div>
            </div>
          </div>

          <!-- Card 2: Your entire process -->
          <div class="bg-[#1a1a1a] rounded-3xl p-12 hover:scale-[1.02] transition-transform relative overflow-hidden">
            <h3 class="text-4xl font-bold text-white mb-6">
              Tu proceso completo en un canvas
            </h3>
            <p class="text-white/70 text-lg leading-relaxed mb-8">
              Todas tus herramientas. Todos tus flujos de trabajo. Un canvas infinito basado en nodos. Ramifica ideas, compara versiones, trabaja con tu equipo.
            </p>
            <div class="relative">
              <div class="aspect-video bg-gradient-to-br from-blue-900/20 to-purple-900/20 rounded-2xl border border-white/10 relative overflow-hidden">
                <!-- Node diagram illustration -->
                <div class="absolute top-1/4 left-1/4 w-32 h-20 bg-cyan-500/20 border border-cyan-400 rounded-lg backdrop-blur-sm flex items-center justify-center">
                  <span class="text-cyan-400 text-xs font-mono">Sensor Data</span>
                </div>
                <div class="absolute top-1/2 right-1/3 w-32 h-20 bg-orange-500/20 border border-orange-400 rounded-lg backdrop-blur-sm flex items-center justify-center">
                  <span class="text-orange-400 text-xs font-mono">Analysis</span>
                </div>
                <div class="absolute bottom-1/4 right-1/4 w-24 h-24 bg-pink-500/20 border-2 border-pink-400 rounded-full backdrop-blur-sm flex items-center justify-center">
                  <span class="text-pink-400 text-xs font-bold">RUN APP</span>
                </div>
                <!-- Connecting lines -->
                <svg class="absolute inset-0 w-full h-full">
                  <path d="M 150 80 Q 200 120 280 140" stroke="rgba(0,229,255,0.3)" stroke-width="2" fill="none"/>
                  <path d="M 350 140 Q 380 160 400 180" stroke="rgba(255,112,67,0.3)" stroke-width="2" fill="none"/>
                </svg>
              </div>
            </div>
          </div>

          <!-- Card 3: One place, whole team -->
          <div class="bg-[#5c3a31] rounded-3xl p-12 hover:scale-[1.02] transition-transform">
            <h3 class="text-4xl font-bold text-white mb-6">
              Un lugar, todo el equipo
            </h3>
            <p class="text-white/80 text-lg leading-relaxed mb-8">
              Organiza recursos de marca, contenido generado y flujos de trabajo con Proyectos. Tu equipo trabaja junto, tu trabajo permanece junto.
            </p>
            <div class="grid grid-cols-2 gap-4">
              <div class="aspect-square bg-gradient-to-br from-pink-300 to-orange-200 rounded-2xl"></div>
              <div class="aspect-square bg-gradient-to-br from-cyan-300 to-teal-200 rounded-2xl"></div>
            </div>
          </div>

          <!-- Card 4: Workflow in one click -->
          <div class="bg-[#1e4a5d] rounded-3xl p-12 hover:scale-[1.02] transition-transform relative overflow-hidden">
            <h3 class="text-4xl font-bold text-white mb-6">
              Flujo de trabajo en un clic
            </h3>
            <p class="text-white/80 text-lg leading-relaxed mb-8">
              Guarda cualquier flujo complejo on-brand como una App. La siguiente persona lo ejecuta en un clic.
            </p>
            <div class="aspect-video bg-gradient-to-br from-orange-500/20 to-yellow-500/20 rounded-2xl border border-white/10 flex items-center justify-center relative">
              <div class="absolute inset-0 bg-[url('/video.mp4')] bg-cover bg-center opacity-30 rounded-2xl"></div>
              <div class="relative z-10 w-32 h-32 bg-pink-500 rounded-full flex items-center justify-center shadow-2xl shadow-pink-500/50 hover:scale-110 transition-transform cursor-pointer">
                <span class="text-white font-bold text-lg">RUN APP</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Section: Case Studies -->
    <section class="py-32 bg-white">
      <div class="container mx-auto px-8 lg:px-16">
        <!-- Section Header -->
        <div class="text-center mb-16">
          <h2 class="text-5xl lg:text-6xl font-bold text-[#2d1810] mb-6">
            Implementado en Achiki O'pala
          </h2>
          <p class="text-xl text-[#2d1810]/70 max-w-3xl mx-auto">
            Proyectos originales realizados por comunidades y expertos alrededor del mundo.
          </p>
        </div>

        <!-- Interactive Case Study Carousel -->
        <CaseStudyCarousel client:load />
      </div>
    </section>

    <!-- Footer CTA Section -->
    <section class="relative h-screen overflow-hidden">
      <!-- Gradient Background -->
      <div class="absolute inset-0 bg-gradient-to-br from-[#4a3461] via-[#6b4a5a] to-[#d97556]"></div>
      
      <!-- Geometric overlay -->
      <div class="absolute inset-0">
        <div class="absolute top-0 left-0 w-full h-1/2 bg-gradient-to-br from-pink-500/20 to-transparent"></div>
        <div class="absolute bottom-0 right-0 w-full h-1/2 bg-gradient-to-tl from-orange-500/20 to-transparent"></div>
        <svg class="absolute inset-0 w-full h-full opacity-30" preserveAspectRatio="none">
          <line x1="0%" y1="0%" x2="100%" y2="100%" stroke="rgba(255,192,203,0.3)" stroke-width="2"/>
          <line x1="100%" y1="30%" x2="0%" y2="80%" stroke="rgba(255,165,0,0.3)" stroke-width="2"/>
        </svg>
      </div>

      <!-- Silhouette Image -->
      <div class="absolute bottom-0 right-0 w-1/2 h-3/4">
        <div class="absolute inset-0 bg-gradient-to-l from-transparent to-[#4a3461]"></div>
        <img src="/video.mp4" alt="Silhouette" class="w-full h-full object-cover object-right opacity-80" />
      </div>

      <!-- Content -->
      <div class="relative z-10 h-full flex items-center">
        <div class="container mx-auto px-8 lg:px-16">
          <div class="max-w-2xl">
            <h2 class="text-6xl lg:text-8xl font-bold text-white mb-12">
              Sé Achiki O'pala
            </h2>
            <a href="/mapa-google" class="bg-[#2d2d2d] text-white px-10 py-5 rounded-xl font-semibold text-xl hover:bg-[#1a1a1a] transition-all flex items-center gap-3 group inline-flex">
              Ver Mapa Interactivo
              <svg class="w-6 h-6 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
              </svg>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Footer -->
    <footer class="bg-[#1a1a1a] text-white py-20">
      <div class="container mx-auto px-8 lg:px-16">
        <div class="grid grid-cols-1 lg:grid-cols-5 gap-12 mb-16">
          <!-- Column 1: Logo & Description -->
          <div class="lg:col-span-2">
            <div class="flex items-center gap-3 mb-6">
              <img src="/logo.png" alt="Achiki O'pala" class="w-10 h-10" />
              <span class="text-2xl font-bold">Achiki O'pala</span>
            </div>
            <p class="text-white/60 mb-8 leading-relaxed">
              El sistema de monitoreo para proteger tu costa. Más de 1 millón de suscriptores en comunidades, empresas, agencias y gobiernos.
            </p>
            <button class="flex items-center gap-2 px-6 py-3 border border-white/20 rounded-lg hover:bg-white/5 transition-colors">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"></path>
              </svg>
              Español
            </button>
          </div>

          <!-- Column 2: Products -->
          <div>
            <h4 class="font-semibold text-sm text-pink-400 uppercase mb-4">Productos</h4>
            <ul class="space-y-3 text-white/60">
              <li><a href="#" class="hover:text-white transition-colors">Sensores</a></li>
              <li><a href="#" class="hover:text-white transition-colors">IA Asistente</a></li>
              <li><a href="#" class="hover:text-white transition-colors">Análisis Geoespacial</a></li>
              <li><a href="#" class="hover:text-white transition-colors">Generador de Reportes</a></li>
              <li><a href="#" class="hover:text-white transition-colors">Alertas de Voz</a></li>
              <li><a href="#" class="hover:text-white transition-colors">Datos Satelitales</a></li>
              <li><a href="#" class="hover:text-white transition-colors">API</a></li>
              <li><a href="#" class="hover:text-white transition-colors">App iOS</a></li>
              <li><a href="#" class="hover:text-white transition-colors">App Android</a></li>
            </ul>
          </div>

          <!-- Column 3: Get started -->
          <div>
            <h4 class="font-semibold text-sm text-cyan-400 uppercase mb-4">Comienza</h4>
            <ul class="space-y-3 text-white/60">
              <li><a href="#" class="hover:text-white transition-colors">Academia</a></li>
              <li><a href="#" class="hover:text-white transition-colors">Documentación</a></li>
              <li><a href="#" class="hover:text-white transition-colors">Soporte</a></li>
              <li><a href="#" class="hover:text-white transition-colors">Términos de uso</a></li>
              <li><a href="#" class="hover:text-white transition-colors">Política de privacidad</a></li>
              <li><a href="#" class="hover:text-white transition-colors">Casos de estudio</a></li>
            </ul>
          </div>

          <!-- Column 4: Company -->
          <div>
            <h4 class="font-semibold text-sm text-orange-400 uppercase mb-4">Organización</h4>
            <ul class="space-y-3 text-white/60">
              <li><a href="#" class="hover:text-white transition-colors">Precios</a></li>
              <li><a href="#" class="hover:text-white transition-colors">Sobre nosotros</a></li>
              <li><a href="#" class="hover:text-white transition-colors">Equipo</a></li>
              <li><a href="#" class="hover:text-white transition-colors">Blog</a></li>
              <li><a href="#" class="hover:text-white transition-colors">Eventos</a></li>
            </ul>
          </div>
        </div>

        <!-- Bottom Bar -->
        <div class="border-t border-white/10 pt-8">
          <p class="text-white/40 text-sm text-center">
            Copyright © 2024-2026 Achiki O'pala. Todos los derechos reservados.
          </p>
        </div>
      </div>
    </footer>
  </main>

  <style>
    .hide-scrollbar::-webkit-scrollbar {
      display: none;
    }
    .hide-scrollbar {
      -ms-overflow-style: none;
      scrollbar-width: none;
    }
  </style>

  <script>
    // Video playback optimization
    const video = document.getElementById('hero-video') as HTMLVideoElement;
    if (video) {
      video.playbackRate = 0.6;
    }
  </script>
</Layout>
